// =============================
// === Waybar modules config ===
// =============================
{
  "reload_style_on_change": true,
  "layer": "top",
  "height": 32,
  // "width": 990,
  "spacing": 0,
  "modules-left": [
    "custom/menu",
    "custom/separator",
    "niri/workspaces",
    "custom/separator",
    "niri/window"
  ],
  "modules-center": [
  ],
  "modules-right": [
    "group/tray-expander",
    "custom/separator",
    "bluetooth#battery",
    "network",
    "battery",
    "custom/separator",
    "clock"
  ],
  // Modules configuration
  "niri/workspaces": {
    "format": "{icon}",
    "format-icons": {
      "default": "",
      "1": "DEV",
      "2": "WWW",
      "3": "IMG",
      "4": "DOC",
      "5": "MSC",
      "6": "SYS",
      "7": "FLS",
      "8": "GFX",
      "9": "TER",
      "10": "MDA"
      // "active": "O"
    }
  },
  "niri/window": {
    "format": "  {title}",
    "max-length": 40,
    "rewrite": {
      "(.*) ": "  ",
      "(.*) ~(.*)": "󰆍  Ghostty",
      "(.*).../(.*)": "󰆍  Ghostty",
      "yagnik@nobara:~(.*)": "󰆍  Ghostty",
      "(.*)nv(.*)": "  Neovim",
      "(.*)Discord(.*)": "   Discord"
    },
    "tooltip": false
  },
  "group/tray-expander": {
    "orientation": "inherit",
    "drawer": {
      "transition-duration": 300,
      "children-class": "tray-group-item"
    },
    "modules": [
      "custom/expand-icon",
      "tray"
    ]
  },
  "custom/expand-icon": {
    "format": "󰇙",
    "tooltip": false
  },
  "group/b-battery": {
    "hide-empty-text": true,
    "orientation": "horizontal",
    "modules": [
      "custom/separator",
      "bluetooth#battery"
    ]
  },
  "bluetooth#battery": {
    "format": "",
    "format-connected-battery": "󰂯 {device_battery_percentage}"
  },
  "tray": {
    "icon-size": 16,
    "spacing": 13
  },
  "clock": {
    "format": "{:%H:%M}",
    "format-alt": "{:%d/%m/%y}",
    "on-click-right": "gnome-calendar",
    "tooltip": false
  },
  "battery": {
    "states": {
        "warning": 10,
        "critical": 4
    },
    "format": "{icon}",
    "format-charging": " {icon}",
    "format-plugged": " {icon}",
    "format-icons": ["󰂎", "󰁺", "󰁻", "󰁼", "󰁽", "󰁾", "󰁿", "󰂀", "󰂁", "󰂂", "󰁹"],
    "interval": 3,
    "tooltip-format": "Battery: {capacity}%"
  },
  "network": {
    "format": "{icon}",
    "format-wifi": "{icon}",
    "format-ethernet": "  {ipaddr}/{cidr}",
    "tooltip-format": "  {ifname} via {gwaddr}",
    "format-linked": "  {ifname} (No IP)",
    "format-disconnected": "󰤮 ",
    "on-click": "nmgui",
    "format-icons": ["󰤯 ", "󰤟 ", "󰤢 ", "󰤥 ", "󰤨 "],
    "tooltip-format-wifi": "{essid} ({signalStrength}%)"
  },
  "custom/separator": {
    "format": "|",
    "tooltip": false
  },
  "custom/menu": {
    "format": "",
    "on-click": "~/scripts/rofi/utilities.sh",
    "tooltip": false
  }
}
