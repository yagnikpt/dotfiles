configuration {
    matching: "fuzzy";
}

@import "noctalia.rasi"

* {
    font: "GeistMono NF, Medium 12";
    background-color: transparent;
    text-color: @fg;
}

window {
    width: 300px;
    border-radius: 4px;
    border: 1px solid;
    border-color: @border;
    background-color: @bg;
    transparency: "real";
    padding: 0;
}

mainbox {
    spacing: 0;
}

inputbar {
    border: 0px 0px 1px 0px;
    border-color: @border;
    padding: 0;
    spacing: 0;
    border-radius: 0;
}

prompt {
    enabled: false;
    padding: 15px;
    border: 0px 1px 0px 0px;
    border-radius: 0px;
    border-color: @border;
}

entry {
    padding: 15px;
    cursor-color: @border;
    cursor-width: 1ch;
}

listview {
    lines: 5;
    scrollbar: false;
    fixed-height: true;
    padding: 8px;
}

element {
    border-radius: 8px;
    spacing: 10px;
    padding: 8px 15px;
}

element selected {
    background-color: @accent;
    text-color: @accent-fg;
}

element-text {
    text-color: inherit;
}

element-icon {
    size: 1em;
}
