{
    "$schema": "https://github.com/fastfetch-cli/fastfetch/raw/dev/doc/json_schema.json",
    "logo": {
        "type": "data",
        "source": " "
    },
    "display": {
        "separator": "  "
    },
    "general": {
        "playerName": "spotify"
    },
    "modules": [
        "break",
        "title",
        {
            "type": "os",
            "key": "os      ",
            "keyColor": "red",
            "format": "{name} {version}"
        },
        {
            "type": "host",
            "format": "{vendor} {family}",
            "key": "host    ",
            "keyColor": "yellow"
        },
        {
            "type": "cpu",
            "key": "cpu     ",
            "format": "{name} ({cores-physical}C/{cores-logical}T) @ {freq-max}",
            "keyColor": "blue"
        },
        {
            "type": "uptime",
            "format": "{?days}{days}d {?}{hours}h {minutes}m",
            "key": "uptime  ",
            "keyColor": "green"
        },
        {
            "type": "memory",
            "key": "memory  ",
            "keyColor": "cyan"
        },
        {
            "type": "de",
            "key": "de      ",
            "keyColor": "yellow"
        },
        {
            "type": "wm",
            "key": "wm      ",
            "keyColor": "yellow"
        },
        {
            "type": "localip",
            "key": "ip      ",
            "keyColor": "magenta"
        },
        {
            "type": "media",
            "key": "media   ",
            "keyColor": "white"
        }
    ]
}

